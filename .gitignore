# Word lists, fetched from the lexicons-v1 release by scripts/fetch_lexicons.py.
# They are data, never part of the repository.
lexicons/

# The default corpus location. The corpus is never part of this project.
input/

# Everything the corrector produces. Regenerate by running it.
lexicon_filtered/
lexicon_filtered__*/
lexicon_corrections*.csv
lexicon_unresolved*.csv
lexicon_filter_checkpoint*.pkl.gz

# Python. The README says to build .venv in this folder, which is precisely
# why git must be told to leave it alone: it is hundreds of MB of spaCy
# models, and it is built, never shared.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
